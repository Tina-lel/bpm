DOWNLOAD_SRC() {
    cd $PKG_DIR/src/
    wget -O nano.tar.gz https://www.nano-editor.org/dist/v9/nano-9.3.tar.gz
    tar -xzf nano.tar.gz --strip-components=1
}

COMPILE_SRC() {
    cd $PKG_DIR/src/
    CFLAGS="$CFLAGS" ./configure --prefix="$PREFIX"
    make "$MAKEFLAGS"
}

INSTALL_PKG() {
    make install
