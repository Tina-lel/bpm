# Package info (socat)
DESCRIPTION="Multipurpose relay"
VERSION="1.8.1.3"
MAINTAINER="Tina_lel <tina_lel@protonmail.com>"

SORT="extra"

COMPILE_DEPENDENCIES=()
DEPENDENCIES=()
DOWNLOAD="true"
COMPILE="true"
ROOT_FOR_INSTALL="${ROOT_FOR_INSTALL:-false}"

PREFIX="${PREFIX:-$HOME/bpm}"

INSTALLED_FILES=($PREFIX/bin/socat)

DOWNLOAD_SRC() {
    cd $PKG_DIR/src/
    wget -O socat.tar.gz http://www.dest-unreach.org/socat/download/socat-1.8.1.3.tar.gz
    tar -xzvf socat.tar.gz --strip-components=1
}

COMPILE_SRC() {
    cd $PKG_DIR/src/
    ./configure CFLAGS="$CFLAGS"
    make "$MAKEFLAGS"
}

INSTALL_PKG() {
    mkdir -p $PREFIX/bin
    cp $PKG_DIR/src/socat $PREFIX/bin/
}
