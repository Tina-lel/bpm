# Package info (Example Package v1)
DESCRIPTION="Example package for BPM"
VERSION="1.0"
MAINTAINER="Tina_lel <tina_lel@protonmail.com>"

SORT="main"

COMPILE_DEPENDENCIES=()
DEPENDENCIES=()
DOWNLOAD="false"
COMPILE="true"
ROOT_FOR_INSTALL="${ROOT_FOR_INSTALL:-false}"

PREFIX="${PREFIX:-$HOME/bpm}"

INSTALLED_FILES=('$PREFIX/bin/bpm_example')

COMPILE_SRC() {
    gcc -o $PKG_DIR/build/bpm_example $CFLAGS $PKG_DIR/src/main.c
}

INSTALL_PKG() {
    mkdir -p $PREFIX/bin
    mv $PKG_DIR/build/bpm_example $PREFIX/bin/
}
