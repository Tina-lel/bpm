# Package info (GZDoom)
DESCRIPTION="GZDoom is a feature centric port for all Doom engine games."
VERSION="git"
MAINTAINER="Tina_lel <tina_lel@protonmail.com>"

SORT="extra"

COMPILE_DEPENDENCIES=()
DEPENDENCIES=()
DOWNLOAD="true"
COMPILE="true"
ROOT_FOR_INSTALL="${ROOT_FOR_INSTALL:-false}"

PREFIX="${PREFIX:-$HOME/bpm}"

INSTALLED_FILES=(\
    '$PREFIX/bin/gzdoom'\
    '$PREFIX/include/dap'\
    '$PREFIX/lib64/cmake'\
    '$PREFIX/lib64/libcppdap.a'\
    '$PREFIX/lib64/libzmusic.so'\
    '$PREFIX/lib64/libzmusic.so.1'\
    '$PREFIX/lib64/libzmusic.so.1.3.0'\
    '$PREFIX/share/applications/org.zdoom.GZDoom.desktop'\
    '$PREFIX/share/doc/gzdoom'\
    '$PREFIX/share/games/doom'\
    '$PREFIX/share/icons/hicolor/scalable/apps/org.zdoom.GZDoom.svg'\
    '$PREFIX/share/metainfo/org.zdoom.GZDoom.metainfo.xml'\
    '$PREFIX/share/mime/packages/org.zdoom.GZDoom-mime.xml')

DOWNLOAD_SRC() {
    cd $PKG_DIR/src
    git clone --depth 1 https://github.com/ZDoom/gzdoom.git
}

COMPILE_SRC() {
    cd $PKG_DIR/src/gzdoom
    mkdir build && cd build
    cmake .. -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=$PREFIX
    make $MAKEFLAGS
}

INSTALL_PKG() {
    make install
}
